{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hold My Notes",
  "version": "0.2.0",
  "identifier": "com.holdmynotes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "Hold My Notes",
      "width": 1180,
      "height": 760,
      "minWidth": 850,
      "minHeight": 560,
      "center": true,
      "decorations": false,
      "resizable": true,
      "transparent": false,
      "shadow": true,
      "visible": true,
      "backgroundColor": "#EEEDE5"
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    }
  }
}
